# Postgres (pgvector-enabled)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/adequia

# Redis (job queue + cache)
REDIS_URL=redis://localhost:6379

# LLM provider — extraction (fast/cheap tier) and scoring/report (stronger tier)
# See docs/01-architecture.md "Model routing"
LLM_API_KEY=
LLM_EXTRACTION_MODEL=
LLM_REASONING_MODEL=

# Embeddings (skill taxonomy + coarse retrieval)
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1536

# Tracing (LangSmith or Langfuse — pick one)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=adequia

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
