# Postgres (pgvector-enabled). Host port is 5433, not 5432 — avoids
# clashing with a native Postgres install already on 5432. Container-to-
# container traffic (api/worker -> postgres) is unaffected, still uses the
# internal "postgres:5432" service address — see docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/adequia

# Redis (job queue + cache)
REDIS_URL=redis://localhost:6379

# MCP server (historical-decisions/skill-taxonomy lookup tools) -- for local
# non-docker `uv run`. docker-compose.yml sets this to http://mcp:8100 for
# the api/worker containers.
MCP_SERVER_URL=http://localhost:8100

# LLM providers — no paid API access, so routing rotates across free-tier
# key pools and falls back to local Ollama when both are exhausted/rate-limited.
# See docs/01-architecture.md "Model routing" and docs/scrum/sprint-1-plan.md (ADQ-2).
GROQ_API_KEYS=
GEMINI_API_KEYS=
OLLAMA_BASE_URL=http://localhost:11434

# Groq/Gemini/Ollama don't share a model-naming scheme, so each provider
# needs its own model per tier — the router resolves the right one for
# whichever provider actually ends up serving a given call.

# Groq: cheapest + most permissive free-tier rate limit for extraction;
# flagship model for reasoning/judgment.
GROQ_EXTRACTION_MODEL=llama-3.1-8b-instant
GROQ_REASONING_MODEL=llama-3.3-70b-versatile

# Gemini: gemini-2.5-pro is paid-only — flash/flash-lite are the free-tier
# options, split the same way as Groq (cheap/fast vs. stronger).
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash-lite
GEMINI_REASONING_MODEL=gemini-2.5-flash

# Ollama (local fallback once both key pools are exhausted):
# `ollama pull hermes3:3b`
OLLAMA_EXTRACTION_MODEL=hermes3:3b
OLLAMA_REASONING_MODEL=hermes3:3b

# Embeddings (skill taxonomy + coarse retrieval) — local via Ollama, no
# paid API, no data leaves the machine. Pull with `ollama pull nomic-embed-text`.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Tracing (LangSmith or Langfuse — pick one)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=adequia
# Only set this if your LangSmith key is on an EU-region org (check under
# Settings on smith.langchain.com) — a US key against the default US
# endpoint needs this left blank. Mismatching the two is the most common
# cause of a 403 Forbidden on trace ingestion.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
